{
	"name": "top-svelte-pocketbase",
	"private": true,
	"version": "2.2.0",
	"type": "module",
	"scripts": {
		"dev": "NODE_ENV=development vite dev",
		"build": "bun --no-env-file scripts/install-kompakkt-runtime.ts && NODE_ENV=production vite build",
		"setup:kompakkt": "bun --no-env-file scripts/install-kompakkt-runtime.ts",
		"release": "bun --no-env-file scripts/release.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"report:authors": "bun scripts/reconcile-author-profiles.ts",
		"migrate:orcid-credits": "bun scripts/migrate-orcid-credits.ts",
		"test:orcid-migration": "bun test scripts/reconcile-author-profiles.test.ts scripts/migrate-orcid-credits.test.ts scripts/import-data.test.ts",
		"images:card-derivatives": "bun scripts/generate-card-derivatives.ts",
		"seed": "bun scripts/seed-data.ts",
		"migrate:viewer-help": "bun scripts/add-viewer-help-field.ts",
		"migrate:workflow": "bun scripts/migrate-workflow-statuses.ts",
		"migrate:proposal": "bun scripts/migrate-proposal-fields.ts",
		"migrate:alpha": "bun scripts/migrate-alpha-review.ts",
		"migrate:publication": "bun scripts/migrate-alpha-review.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.5",
		"@faker-js/faker": "^10.1.0",
		"@iconify/json": "^2.2.398",
		"@inlang/paraglide-js": "^2.29.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.18",
		"@types/bun": "^1.4.2",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"mdsvex": "^0.12.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.3.2",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^22.5.0",
		"vite": "^7.3.7",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.4",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-image": "^3.32.2",
		"@tiptap/extension-link": "^3.32.2",
		"@tiptap/extension-placeholder": "^3.32.2",
		"@tiptap/extension-table": "^3.32.2",
		"@tiptap/extension-table-cell": "^3.32.2",
		"@tiptap/extension-table-header": "^3.32.2",
		"@tiptap/extension-table-row": "^3.32.2",
		"@tiptap/extension-underline": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"bson": "^6.10.4",
		"daisyui": "^5.3.7",
		"dompurify": "^3.4.17",
		"pocketbase": "^0.26.3",
		"sanitize-html": "^2.18.1",
		"svelte-french-toast": "^1.2.0",
		"svelte-persisted-store": "^0.12.0"
	}
}
